#!/usr/bin/env python3
"""
ordis — Ordis 统一 CLI 入口。

用法:
    ordis run          启动守护进程
    ordis once         运行一轮检查（调试）
    ordis events       查看触发事件
    ordis cases        查看 AI 诊断案例
    ordis status       查看系统状态
    ordis model        AI 供应商管理 (添加/切换/测试)

等价于 `python ordis/ordisd.py <cmd>`；引擎逻辑全部在 ordis/ordisd.py，
本文件只是薄启动器，负责把引擎目录挂进 sys.path。
"""

import sys
from pathlib import Path

ENGINE_DIR = Path(__file__).resolve().parent / "ordis"
if not ENGINE_DIR.exists():
    # 兼容：启动器被直接放进 ordis/ 目录内的布局
    ENGINE_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(ENGINE_DIR))


def main() -> int:
    import ordisd
    return ordisd.main()


if __name__ == "__main__":
    sys.exit(main())
